# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
# For local development without Docker, run `npm run db:local` and use:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/makemyresume"

# Secret for session cookies and signed print tokens. Generate with:
#   npx auth secret     (or)     openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the app (used in emails, sitemaps and metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional ---------------------------------------------------------------

# Product name shown in the UI (defaults to "MakeMyResume").
NEXT_PUBLIC_APP_NAME=""

# Google sign-in. The Google button only appears when both are set.
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required by Auth.js when running behind a proxy / in production.
AUTH_TRUST_HOST="true"

# Password reset emails via Resend (https://resend.com). Without these, reset
# links are printed to the server console in development only.
RESEND_API_KEY=""
EMAIL_FROM=""

# PDF export uses headless Chromium. Leave empty to use the Playwright-managed
# browser (`npx playwright install chromium`), or point to a system Chromium.
CHROMIUM_EXECUTABLE_PATH=""
# Origin the PDF renderer uses to reach this app (defaults to the request origin).
INTERNAL_APP_URL=""

# Plan requests: no payment gateway yet, so "Get plan" opens a pre-filled Gmail
# message to this address. Activate paid plans with `npm run plan:grant`.
NEXT_PUBLIC_PLAN_REQUEST_EMAIL="shelatkarvedang2@gmail.com"

# Google Search Console verification token (meta tag content), optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Log analytics events to the server console (no resume content is ever included).
ANALYTICS_DEBUG="false"
